#!/usr/bin/env bash
# This is a mock of sbatch
# Will record:
# - Arguments it was called with
# - all the relevant environment variables

SBATCH_LOG=$MOCKLOGDIR/sbatch.log

BASEMOCK="$(cd "$(dirname "${BASH_SOURCE[0]}" )" > /dev/null 2>&1 && pwd)"/basemock
# shellcheck source=./tests/mocks/bin/basemock
source "$BASEMOCK" "$SBATCH_LOG" "$@"

SBATCH_PIDS=$MOCKLOGDIR/pids.txt


# This list of variables has been collected
# with a script from the output of `man sbatch`.
function _on_horeka () {
    hostname | grep -q -E "hkn[0-9]{4}.localdomain"
}

MOCKS="$(cd "$(dirname "${BASH_SOURCE[0]}" )" > /dev/null 2>&1 && pwd)"
SRC="$(cd "$(dirname "${BASH_SOURCE[0]}" )"/../../../src > /dev/null 2>&1 && pwd)"
if _on_horeka
then
  mapfile -t INPUT_VARIABLES < <("$SRC"/slurm-utils/_get-sbatch-input-env-list.sh)
else
  mapfile -t INPUT_VARIABLES < <("$MOCKS"/get-sbatch-input-env-list.sh)
fi

for VARIABLE in "${INPUT_VARIABLES[@]}"
do
   set +o nounset
   if [[ -n "${!VARIABLE}" ]]
   then
       echo "$VARIABLE"="${!VARIABLE}" >> "$SBATCH_LOG"
   fi
   set -o nounset
done

# Execute first non-option argument
declare -i count
count=0
while [[ "$1" =~ ^-  || -z $1 ]]
do
    # Unfortunately we need to use -n and -t without =
    # so in this case we need to shift twice
    if [[ "$1" == '-n' || "$1" == '-t' ]]
    then
        shift # shift for the option
        shift # additional shift for the argument
    else
        shift # shift for the option
    fi
    if [[ $count -gt 30 ]]
    then
        echo "Error in sbatch mock arg list" >&2
        exit 20
    fi
    count=$((count+1))
done

echo 987654321
("$@" 1> slurm-987654321.out 2> slurm-987654321.err) &
echo $! "$@" >> "$SBATCH_PIDS"
