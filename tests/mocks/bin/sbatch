#!/bin/bash
# This is a mock of sbatch
# Will record:
# - Arguments it was called with
# - all the relevant environment variables

[ ! -z $MOCKLOGDIR ] || {
    echo "The mock needs a place to store logs"
    exit 1
}

SBATCH_LOG=$MOCKLOGDIR/sbatch.log

echo ARGS: $@ > $SBATCH_LOG


# This list of variables has been collected
# with a script from the output of `man sbatch`.
function _on_horeka () {
    hostname | grep -q -E "hkn[0-9]{4}.localdomain"
}

if [[ $(_on_horeka) ]]
then
  echo "Hey, on horeka!"
  mapfile INPUT_VARIABLES < <(_get-sbatch-input-env-list.sh)
else
  source sbatch-input-variable-list.sh
fi

for VARIABLE in ${INPUT_VARIABLES[@]}
do if [[ ! -z ${!VARIABLE} ]]
   then
       echo $VARIABLE=${!VARIABLE} >> $SBATCH_LOG
   fi
done

# Execute last argument
LAST_ARG_IDX=$#
"${!LAST_ARG_IDX}" #&> /dev/null &

echo "Submitted" "${!LAST_ARG_IDX}"
