#!/usr/bin/env bash

[ -n "$MOCKLOGDIR" ] || {
    echo "The mock needs a place to store logs" >&2
    exit 45
}


ENROOT_LOG=$MOCKLOGDIR/enroot.log
mkdir -p "$MOCKLOGDIR"/.enroot-fakecontainers

echo "ARGS:" "$@" >> "$ENROOT_LOG"


{ env | grep -E '^ENROOT_\w+_PATH' >> "$ENROOT_LOG"; } || true

if [[ "$1" =~ remove ]]
then
    cat - >> "$ENROOT_LOG"
    rm "$MOCKLOGDIR"/.enroot-fakecontainers/"$2"
fi

if [[ "$1" =~ create ]]
then
    touch "$MOCKLOGDIR"/.enroot-fakecontainers/"$3"
fi

if [[ "$1" =~ list ]]
then
    ( cd "$MOCKLOGDIR"/.enroot-fakecontainers || exit; ls)
fi

if [[ "$1" =~ start ]]
then
    count=0
while [[ ! "$1" =~ --  && count -lt 10 ]]
do
    shift
    count=$((count+1))
done
# last shift, for --
shift
"$@"
fi
