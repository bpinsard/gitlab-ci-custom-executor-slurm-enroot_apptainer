#!/usr/bin/env bash

ENROOT_LOG=$MOCKLOGDIR/enroot.log

BASEMOCK="$(cd "$(dirname "${BASH_SOURCE[0]}" )" > /dev/null 2>&1 && pwd)"/basemock
# shellcheck source=./tests/mocks/bin/basemock
source "$BASEMOCK" "$ENROOT_LOG" "$@"

mkdir -p "$MOCKLOGDIR"/.enroot-fakecontainers



{ env | grep -E '^ENROOT_\w+_PATH' >> "$ENROOT_LOG"; } || true

if [[ "$1" =~ import ]]
then
    shift
    count=0
    while [[  "$1" != --output  && "$count" -lt 10 ]]
    do
        shift
        count=$((count+1))
    done
    if [[ "$count" -eq 10 ]]
    then
        echo "no --output " >&2
        exit 0
    else
        touch "$2"
    fi
fi

if [[ "$1" =~ remove ]]
then
    cat - >> "$ENROOT_LOG"
    rm "$MOCKLOGDIR"/.enroot-fakecontainers/"$2"
fi
if [[ "$1" =~ create ]]
then
    if [[ "$#" -ne 4 ]]
    then
        echo "Image name missing!" >&2
        exit 22
    fi
    touch "$MOCKLOGDIR"/.enroot-fakecontainers/"$3"
fi

if [[ "$1" =~ list ]]
then
    ( cd "$MOCKLOGDIR"/.enroot-fakecontainers || exit; ls)
fi

if [[ "$1" =~ start ]]
then
    count=0
while [[ ! "$1" == "--"  && "$count" -lt 10 ]]
do
    shift
    count=$((count+1))
done
# shift for --
shift
# shift for the container name
shift
"$@"
fi
