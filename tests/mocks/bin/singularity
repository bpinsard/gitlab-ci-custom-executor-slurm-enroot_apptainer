#!/usr/bin/env bash

SINGULARITY_LOG=$MOCKLOGDIR/singularity.log

BASEMOCK="$(cd "$(dirname "${BASH_SOURCE[0]}" )" > /dev/null 2>&1 && pwd)"/basemock
# shellcheck source=./tests/mocks/bin/basemock
source "$BASEMOCK" "$SINGULARITY_LOG" "$@"

# Save singularity variables in the log
{ env | grep -E '^SINGULARITY' | grep -v SINGULARITY_LOG >> "$SINGULARITY_LOG"; } || true


set +o nounset
if [[ -z "$APPTAINER_CACHEDIR" ]]
then
    APPTAINER_CACHEDIR="$HOME/.singularity"
fi
set -o nounset
mkdir -p "$APPTAINER_CACHEDIR/cache"

# if the first argument is exec
# execute last argument - notice the space
if [[ "${1}" == exec ]]
then
    "${@: -1}"
fi

# if the first argument
if [[ "$1" =~ (pull|build) ]]
then
    # Should use a directory because the image could be a sandbox
    if [[ "$#" -eq 3 ]]
    then touch "$2"
    else touch "image-default-name.sif"
    fi
fi
