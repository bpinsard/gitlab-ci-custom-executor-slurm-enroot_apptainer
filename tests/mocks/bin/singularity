#!/usr/bin/env bash

SINGULARITY_LOG=$MOCKLOGDIR/singularity.log

BASEMOCK="$(cd "$(dirname "${BASH_SOURCE[0]}" )" > /dev/null 2>&1 && pwd)"/basemock
# shellcheck source=./tests/mocks/bin/basemock
source "$BASEMOCK" "$SINGULARITY_LOG" "$@"

if [[ -z "$SINGULARITY_CACHEDIR" ]]
then
    SINGULARITY_CACHEDIR="$HOME/.singularity"
fi
mkdir -p "$SINGULARITY_CACHEDIR/cache"
