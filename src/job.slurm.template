#!/usr/bin/env bash
#SBATCH --job-name GitLabCustomExec
#SBATCH --partition %CUSTOM_ENV_DEFAULT_PARTITION%
#SBATCH --ntasks 1
#SBATCH --time 30


if [[ "${TRACE-0}" == "1" ]]; then set -o xtrace; fi
set -o nounset
set -o errexit
set -o pipefail

CUSTOM_EXECUTOR_QUEUE_WORKSPACE=$1
SRC=$2

# shellcheck source=./src/custom_executor_queue.sh
source "$SRC"/custom_executor_queue.sh

echo -n "Starting custom executor queue... " >&2
start_custom_executor_queue "$CUSTOM_EXECUTOR_QUEUE_WORKSPACE"
echo -n "done. Waiting." >&2

# shellcheck disable=SC1091
source "$CUSTOM_EXECUTOR_QUEUE_WORKSPACE"/.env

# shellcheck disable=SC2064
trap "kill -s SIGUSR1 $CUSTOM_EXECUTOR_QUEUE_PID; wait; exit" SIGUSR1
# shellcheck disable=SC2064
trap "kill -s SIGTERM $CUSTOM_EXECUTOR_QUEUE_PID; wait; exit" SIGTERM
# shellcheck disable=SC2064
trap "touch $CUSTOM_EXECUTOR_QUEUE_WORKSPACE/terminated;" EXIT

while ps --pid "$CUSTOM_EXECUTOR_QUEUE_PID"  > /dev/null
do 
	sleep  1
done
